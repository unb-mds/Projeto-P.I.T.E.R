# Backend Environment Variables
# URL da API de NLP (pode ser local ou em container)
SPACY_API_URL=http://localhost:8001

# Domínios permitidos para CORS (frontend)
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Host e porta usados pelo backend FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Nome e versão da aplicação
APP_NAME=PITER API
APP_VERSION=0.1.0
